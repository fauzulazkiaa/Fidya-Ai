# Copy to web/.env.local. All values are optional for local demo mode.

# Leave empty to skip Clerk. middleware.ts then passes every route through,
# and useFidyaAuth() returns a local mock user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The UI calls same-origin /api/v1. next.config.ts proxies that prefix here.
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://127.0.0.1:8000

# Read by prisma/schema.prisma only. The Next.js app does not query Prisma.
DATABASE_URL=
DIRECT_URL=

# Used by web/scripts (SEO automator and the Search Console blueprint), not by the app.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=
GSC_SITE_URL=
GSC_CREDENTIALS_PATH=
