# Copy to web/.env.local. All values are optional for a local demo.
# Middleware treats the app as signed-out demo mode when the Clerk key is empty.

# Clerk (https://dashboard.clerk.com). Leave blank to skip route protection.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Read by @clerk/nextjs when the publishable key is set.
CLERK_SECRET_KEY=

# FastAPI origin used by the Next.js rewrite in next.config.ts.
BACKEND_URL=http://127.0.0.1:8000

# Browser API base. Default /api/v1 is proxied to BACKEND_URL.
NEXT_PUBLIC_API_URL=/api/v1

# Only needed if you run Prisma against this schema. The Next.js app does
# not import Prisma; product data goes through the FastAPI backend.
# DATABASE_URL=
# DIRECT_URL=
